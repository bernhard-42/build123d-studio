node_modules/

# Vite build output (Neutralino's documentRoot)
resources/

# The Neutralino binaries. Not committed - they would be 14 MB now and another
# 14 MB on every version bump, in history for ever - but not fetched blindly
# either: scripts/ensure-neutralino.mjs checks each one against the digests in
# scripts/neutralino-pin.json before any build, and downloads the pinned release
# when they are missing or wrong. These binaries become the application
# executable in every package, and they used to arrive through a postinstall
# hook with no verification at all.
bin/
.tmp/
dist/
neutralinojs.log

# Packaged artifacts
release/

# Neutralino's per-app storage: window layout, theme, package sources
.storage/

# runtime/ ships only pyproject.toml and uv.lock; the environment itself is
# created by uv in the per-user app-data directory, outside the repository.

__pycache__/
*.py[cod]
.DS_Store
