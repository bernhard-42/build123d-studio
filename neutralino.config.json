{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "dev.build123dstudio.app",
  "version": "0.5.1",
  "applicationName": "build123d Studio",
  "author": "Bernhard Walter",
  "description": "A standalone build123d IDE",
  "copyright": "Copyright 2026 Bernhard Walter",
  "defaultMode": "window",
  "dataLocation": "system",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "enableExtensions": false,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "window.*",
    "events.*",
    "clipboard.*",
    "computer.getOSInfo"
  ],
  "modes": {
    "window": {
      "title": "build123d Studio",
      "width": 1600,
      "height": 1000,
      "minWidth": 800,
      "minHeight": 600,
      "center": true,
      "icon": "/resources/icons/appIcon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": true,
      "resizable": true,
      "exitProcessOnClose": false
    }
  },
  "cli": {
    "binaryName": "build123d-studio",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}
